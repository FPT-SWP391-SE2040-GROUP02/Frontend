# Environment Variables Template
# Copy this file to .env and adjust values for your local development

# Backend API Endpoint (C# ASP.NET Core)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# App Info
VITE_APP_NAME="LegacyVault"
VITE_APP_VERSION="1.0.0"

# Public browser settings only. Every VITE_ value can be included in the bundle.
VITE_DEMO_MODE=false
VITE_GOOGLE_CLIENT_ID=
VITE_LIVEKIT_URL=
