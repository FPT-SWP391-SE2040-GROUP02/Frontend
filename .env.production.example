# ==============================================================================
# LegacyVault Frontend (Vite + React 18) - Production Environment Variables
# Copy or set these in Vercel Project Settings (Environment Variables)
# ==============================================================================

# 1. Backend REST API URL (Trỏ đến dịch vụ Render đã deploy)
VITE_API_BASE_URL=https://your-legacyvault-api.onrender.com/api/v1

# 2. Google OAuth Client ID (Trùng khớp với Backend GoogleAuth:ClientId)
# Lưu ý: Cần thêm domain Vercel (vd: https://your-legacyvault.vercel.app) vào "Authorized JavaScript origins" trên Google Cloud Console
VITE_GOOGLE_CLIENT_ID=717961939025-32a9snln6rvn7pu3va9are8dhcabvmr7.apps.googleusercontent.com

# 3. Application Metadata
VITE_APP_NAME="LegacyVault"
VITE_APP_VERSION="1.0.0"

# 4. Feature Flags
VITE_DEMO_MODE=false
